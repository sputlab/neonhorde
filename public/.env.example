# Rinomina questo file in ".env" e posizionalo FUORI dalla document root pubblica
# se possibile, oppure proteggilo via .htaccess (vedi README).

DB_HOST=127.0.0.1
DB_NAME=your_database_name
DB_USER=change_me_db_user
DB_PASS=change_me_strong_password
DB_CHARSET=utf8mb4

# Indirizzo mittente per le email di reset password (deve appartenere
# allo stesso dominio dell'hosting per evitare che finisca in spam)
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=NEON HORDE

# Obbligatorio: min. 32 caratteri (es. `openssl rand -hex 32`), altrimenti l'API risponde 500.
# Usato per firmare/derivare i token di sessione (stringa lunga e casuale)
APP_SECRET=change_me_to_a_long_random_string

# Durata token di sessione in secondi (default 30 giorni)
SESSION_TTL=2592000

# Ambiente: "production" disattiva la visualizzazione errori dettagliati
APP_ENV=production
